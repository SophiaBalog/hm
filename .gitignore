# Python / Django кеш та скомпільовані файли
__pycache__/
*.py[cod]
*$py.class

# Віртуальне середовище (Python Virtual Environment)
.venv/
venv/
ENV/
env/

# База даних SQLite (містить локальні дані)
*.sqlite3
*.db

# Файли конфігурації середовища (секретні ключі, паролі)
.env
.env.*

# Налаштування редакторів коду та IDE
.vscode/
.idea/

# Логи та тимчасові файли
*.log
*.tmp

# Статичні файли та медіа (якщо генеруються локально)
/staticfiles/
/media/